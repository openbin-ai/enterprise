# Per-install state. Never commit a customer's secrets.
.env
config/Caddyfile
config/keycloak/import/*.json
config/tls/*
config/.public-urls
config/.realm-settings
config/keycloak/truststores/*
!config/keycloak/truststores/.gitkeep
!config/tls/.gitkeep

# Fetched release assets and built bundles.
downloads/*
!downloads/.gitkeep
dist/
*.tar
*.tar.gz
*.tar.zst
