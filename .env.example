# OpenBin Enterprise — generated by install.sh. Hand-edit only if you know
# what each line feeds; then run `bin/openbin-enterprise render` and
# `bin/openbin-enterprise up` so the proxy and realm pick up the change.

# ---- release ---------------------------------------------------------------
OPENBIN_VERSION=2026.11.0
IMAGE_PREFIX=ghcr.io/openbin-ai/enterprise

# ---- layout ----------------------------------------------------------------
# ip     : reached by address, no DNS. Uses HOST_IP and two HTTPS ports:
#            HOST_IP=10.0.4.17
#            OPENBIN_PORT=443     # OpenBin; also carries /api, /auth and storage
#            OPENAPK_PORT=8443    # OpenAPK
#            TLS_EXTRA_SANS=      # extra IPs / names for the certificate
#          Change any of them by re-running install.sh with --ip /
#          --openbin-port / --openapk-port.
# domain : five hostnames under one base domain (below), all resolving here.
INSTALL_MODE=domain

# ---- hostnames (domain layout) ---------------------------------------------
OPENBIN_DOMAIN=re.example.com
APP_HOST=app.re.example.com       # OpenBin web app (native binaries, scripts)
APK_HOST=apk.re.example.com       # OpenAPK web app (Android)
API_HOST=api.re.example.com       # backend
AUTH_HOST=auth.re.example.com     # Keycloak
S3_HOST=s3.re.example.com         # MinIO (presigned uploads/downloads)
HTTP_PORT=80
HTTPS_PORT=443

# ---- TLS -------------------------------------------------------------------
# internal : Caddy issues certificates from its own CA (air-gapped default).
#            Export the root with `bin/openbin-enterprise ca-cert`.
# acme     : public certificates from Let's Encrypt (host must be reachable
#            on :80/:443 from the internet). Needs ACME_EMAIL.
# custom   : your own certificate for *.OPENBIN_DOMAIN (or for HOST_IP),
#            placed in config/tls/fullchain.pem and config/tls/privkey.pem.
# selfsigned : ip layout default. install.sh creates a CA and a certificate
#            for HOST_IP in config/tls/; the CA is served at
#            /downloads/openbin-ca.crt for analysts to import.
TLS_MODE=internal
ACME_EMAIL=

# ---- first administrator ---------------------------------------------------
# Platform admin (allowlisted for /api/admin) and Keycloak bootstrap admin.
ADMIN_EMAIL=admin@example.com
# ip layout: this user is created on first boot with a temporary password
# (they must change it at first sign-in). Empty = no user is created.
ADMIN_INITIAL_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# ---- policy ----------------------------------------------------------------
# Let people create their own accounts on the sign-in page (install.sh
# turns this on for installs reached by IP address, off with --domain).
# Off means accounts come from an administrator, LDAP, or SSO (docs/sso.md).
# Change with ./install.sh --self-registration / --no-self-registration.
SELF_REGISTRATION=false
# Require users to accept the bundled Terms of Service before using the app.
TOS_REQUIRED=false
# Hostnames / CIDRs that BYOK model endpoints may resolve to on private
# networks (internal LLM gateway). Empty = public internet only.
LLM_EGRESS_ALLOWLIST=

# ---- generated secrets (install.sh fills these) -----------------------------
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
MINIO_ROOT_USER=openbin
MINIO_ROOT_PASSWORD=
OPENAPK_KEK_B64=
JADX_WORKER_TOKEN=
KEYCLOAK_CORE_CLIENT_SECRET=

# ---- sizing ----------------------------------------------------------------
CORE_MEM=3g
GHIDRA_MEM=8g
JADX_MEM=6g
