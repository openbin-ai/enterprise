{
  "realm": "openapk",
  "enabled": true,
  "displayName": "OpenBin",
  "registrationAllowed": __REGISTRATION_ALLOWED__,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "loginTheme": "openbin",
  "clients": [
    {
      "clientId": "openapk-frontend",
      "name": "OpenBin / OpenAPK web apps",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__APP_ORIGIN__/*##__APK_ORIGIN__/*"
      },
      "redirectUris": ["__APP_ORIGIN__/*", "__APK_ORIGIN__/*"],
      "webOrigins": ["__APP_ORIGIN__", "__APK_ORIGIN__"],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"]
    },
    {
      "clientId": "openbin-cli",
      "name": "OpenBin CLI",
      "description": "Device-authorization grant for the openbin CLI and BINNY. No secret, no redirect URI.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": ["acr", "profile", "roles", "email"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "openbin-core",
      "name": "OpenBin backend (service account)",
      "description": "Used by the backend to delete a user's Keycloak identity when they delete their account.",
      "enabled": true,
      "publicClient": false,
      "secret": "__CORE_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-openbin-core",
      "enabled": true,
      "serviceAccountClientId": "openbin-core",
      "clientRoles": { "realm-management": ["manage-users", "view-users"] }
    }
  ]
}
